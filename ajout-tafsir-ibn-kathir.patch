+// @ts-ignore
+import {
+  handleGet,
+  integerParameter,
+  json,
+  RequestError,
+} from "../_shared/http.ts";
+
+// @ts-ignore
+import { getQuranFoundationSdk } from "../_shared/quranFoundation.ts";
+
+// @ts-ignore
+import { serve } from "../_shared/runtime.ts";
+
+type RawTafsir = {
+  id?: number;
+  resourceId?: number;
+  resource_id?: number;
+  resourceName?: string;
+  resource_name?: string;
+  languageName?: string;
+  language_name?: string;
+  name?: string;
+  translatedName?: {
+    name?: string;
+    languageName?: string;
+  };
+  translated_name?: {
+    name?: string;
+    language_name?: string;
+  };
+  text?: string;
+};
+
+type RawVersePayload = {
+  verse?: {
+    tafsirs?: RawTafsir[];
+  };
+  tafsirs?: RawTafsir[];
+};
+
+serve(
+  handleGet(async (request) => {
+    const { searchParams } = new URL(request.url);
+    const verseKey = searchParams.get("verse_key")?.trim();
+
+    if (!verseKey || !/^\d{1,3}:\d{1,3}$/.test(verseKey)) {
+      throw new RequestError("Invalid verse_key parameter");
+    }
+
+    const [chapterNumber, verseNumber] = verseKey.split(":").map(Number);
+    if (
+      chapterNumber < 1 ||
+      chapterNumber > 114 ||
+      verseNumber < 1
+    ) {
+      throw new RequestError("Invalid Quran verse key");
+    }
+
+    const resourceId = integerParameter(
+      searchParams,
+      "resource_id",
+      1,
+      10000,
+      { fallback: 169 },
+    )!;
+
+    const sdk = getQuranFoundationSdk();
+    const response = await sdk.content.v4.verses.byKey(
+      verseKey,
+      {
+        tafsirs: [resourceId],
+      },
+    );
+
+    const payload = response as unknown as RawVersePayload;
+    const tafsirs = payload.verse?.tafsirs ?? payload.tafsirs ?? [];
+    const tafsir = tafsirs.find(
+      (item) =>
+        (item.resourceId ?? item.resource_id) === resourceId,
+    ) ?? tafsirs[0];
+
+    if (!tafsir?.text) {
+      throw new RequestError(
+        `Tafsir unavailable for verse ${verseKey}`,
+        404,
+      );
+    }
+
+    return json({
+      verseKey,
+      resourceId:
+        tafsir.resourceId ??
+        tafsir.resource_id ??
+        resourceId,
+      resourceName:
+        tafsir.resourceName ??
+        tafsir.resource_name ??
+        tafsir.translatedName?.name ??
+        tafsir.translated_name?.name ??
+        tafsir.name ??
+        "Tafsir Ibn Kathir",
+      languageName:
+        tafsir.languageName ??
+        tafsir.language_name ??
+        tafsir.translatedName?.languageName ??
+        tafsir.translated_name?.language_name ??
+        "english",
+      text: tafsir.text,
+    });
+  }),
+);
