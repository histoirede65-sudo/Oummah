+                  {verse.translation}
+                </Text>
+              ) : null}
+            </View>
+          ) : null}
+
+          <View style={styles.sourceCard}>
+            <View style={styles.sourceIcon}>
+              <Ionicons
+                name="library-outline"
+                size={18}
+                color={colors.goldLight}
+              />
+            </View>
+
+            <View style={styles.sourceCopy}>
+              <Text style={styles.sourceName}>
