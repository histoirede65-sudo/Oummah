{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oummah.app/schemas/additives-scientific-data.schema.json",
  "title": "OUMMAH additive scientific data import",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["code", "names", "aliases", "authorityEvaluations", "potentialEffects", "restrictions", "evidenceLevel", "sources", "lastReviewedAt", "dataVersion"],
    "properties": {
      "code": { "type": "string", "pattern": "^E[0-9]{3,4}[A-Z]?$" },
      "names": { "type": "object", "properties": { "fr": { "type": "string" }, "en": { "type": "string" } }, "additionalProperties": false },
      "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "function": { "type": "string" },
      "regulatoryStatus": { "type": "object", "properties": { "eu": { "type": "string" }, "notes": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
      "authorityEvaluations": { "type": "array", "items": { "type": "object", "required": ["authority", "conclusion"], "properties": { "authority": { "type": "string" }, "year": { "type": "integer" }, "conclusion": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "evaluationType": { "type": "string" }, "reviewedAt": { "type": "string", "format": "date" } }, "additionalProperties": false } },
      "exposure": { "type": "object", "properties": { "adi": { "type": "number" }, "tdi": { "type": "number" }, "unit": { "type": "string" }, "estimatedExposure": { "type": "string" }, "populationsAtRisk": { "type": "array", "items": { "type": "string" } }, "notes": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
      "potentialEffects": { "type": "array", "items": { "type": "object", "required": ["effect", "severity", "evidenceLevel", "appliesTo"], "properties": { "effect": { "type": "string" }, "severity": { "enum": ["none", "low", "moderate", "serious"] }, "evidenceLevel": { "enum": ["insufficient", "limited", "moderate", "strong"] }, "appliesTo": { "enum": ["additive", "metabolite", "contaminant", "degradation_product"] }, "notes": { "type": "string" } }, "additionalProperties": false } },
      "restrictions": { "type": "array", "items": { "type": "string" } },
      "evidenceLevel": { "enum": ["insufficient", "limited", "moderate", "strong"] },
      "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["sourceId", "organisation", "sourceType", "title", "url", "retrievedAt", "fieldsSupported"], "properties": { "sourceId": { "type": "string" }, "organisation": { "type": "string" }, "sourceType": { "type": "string" }, "title": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "publishedAt": { "type": "string" }, "retrievedAt": { "type": "string", "format": "date" }, "fieldsSupported": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
      "lastReviewedAt": { "type": "string", "format": "date" },
      "dataVersion": { "type": "string", "pattern": "^(?:reviewed-)?[0-9]+\\.[0-9]+$" },
      "needsScientificReview": { "type": "boolean" }
    },
    "additionalProperties": false
  }
}
