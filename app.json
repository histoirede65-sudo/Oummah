{
  "expo": {
    "name": "Oummah",
    "slug": "oummah",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "oummah",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.oummah.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocationWhenInUseUsageDescription": "OUMMAH utilise votre position lorsque vous utilisez l’application afin de calculer les horaires de prière correspondant à votre localisation et de vous aider à trouver les mosquées à proximité."
      }
    },
    "android": {
      "package": "com.oummah.app",
      "versionCode": 14,
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2B53D",
          "defaultChannel": "adhan-sound-makkah",
          "sounds": [
            "./assets/adhan/adhan_makkah.mp3",
            "./assets/adhan/adhan_madinah.mp3",
            "./assets/adhan/adhan_egypt.mp3"
          ]
        }
      ],
      [
        "./modules/prayer-times-widget/app.plugin.js",
        {
          "targetName": "PrayerTimesWidgetExtension",
          "bundleIdentifier": "com.oummah.app.prayerwidget",
          "groupIdentifier": "group.com.oummah.app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfc1e1ce-a09c-4279-861c-8c07e081d86c",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PrayerTimesWidgetExtension",
                  "bundleIdentifier": "com.oummah.app.prayerwidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.oummah.app"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "bahrioummah"
  }
}
