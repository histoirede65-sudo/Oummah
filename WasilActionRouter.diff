+  "selon",
+];
+
+function isDocumentaryQuestion(value: string) {
+  const normalizedValue = normalize(value);
+  return DOCUMENTARY_QUESTION_STARTERS.some(
+    (starter) =>
+      normalizedValue === normalize(starter) ||
+      normalizedValue.startsWith(`${normalize(starter)} `),
+  );
+}
