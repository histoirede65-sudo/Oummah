<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Home screen / lock screen shortcut that opens the product scanner directly. -->
    <receiver
      android:name="com.oummah.scanwidget.ScanWidgetProvider"
      android:exported="true"
      android:label="@string/scan_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/scan_widget_info" />
    </receiver>
    <!-- Home screen / lock screen shortcut that opens « Halal autour de moi ». -->
    <receiver
      android:name="com.oummah.scanwidget.HalalWidgetProvider"
      android:exported="true"
      android:label="@string/halal_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/halal_widget_info" />
    </receiver>
    <!-- Home screen / lock screen shortcut that opens the Qibla compass. -->
    <receiver
      android:name="com.oummah.scanwidget.QiblaWidgetProvider"
      android:exported="true"
      android:label="@string/qibla_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/qibla_widget_info" />
    </receiver>
    <!-- « Reprendre le Coran »: the Mushaf bookmark, one tap to continue reading. -->
    <receiver
      android:name="com.oummah.scanwidget.QuranWidgetProvider"
      android:exported="true"
      android:label="@string/quran_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/quran_widget_info" />
    </receiver>
    <!-- Home screen: verse of the day (Arabic + translation). -->
    <receiver
      android:name="com.oummah.scanwidget.DailyVerseWidgetProvider"
      android:exported="true"
      android:label="@string/daily_verse_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/daily_verse_widget_info" />
    </receiver>
    <!-- Home screen: hadith of the day. -->
    <receiver
      android:name="com.oummah.scanwidget.DailyHadithWidgetProvider"
      android:exported="true"
      android:label="@string/daily_hadith_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/daily_hadith_widget_info" />
    </receiver>
  </application>
</manifest>
