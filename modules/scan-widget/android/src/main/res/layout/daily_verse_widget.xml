<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/daily_verse_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/oummah_widget_night_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/daily_verse_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:letterSpacing="0.12"
    android:text="@string/daily_verse_label"
    android:textAllCaps="true"
    android:textColor="#D9F2B53D"
    android:textSize="10sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/daily_verse_arabic"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:gravity="end"
    android:maxLines="2"
    android:textColor="#FFF2B53D"
    android:textDirection="rtl"
    android:textSize="18sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/daily_verse_text"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="6dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:fontFamily="serif"
    android:text="@string/daily_widget_empty"
    android:textColor="#FFF8F1DE"
    android:textSize="14sp" />

  <TextView
    android:id="@+id/daily_verse_reference"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:maxLines="1"
    android:textColor="#B3F2B53D"
    android:textSize="11sp" />
</LinearLayout>
