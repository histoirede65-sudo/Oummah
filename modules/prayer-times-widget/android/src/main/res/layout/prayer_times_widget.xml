<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171026">

  <ImageView
      android:id="@+id/prayer_widget_art"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:contentDescription="Horaires de priere OUMMAH"
      android:scaleType="fitXY" />

  <!--
    Keep the live Android Chronometer, but place it in the same visual zone as
    the iOS countdown instead of centering it over the whole widget.
  -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:gravity="center_horizontal">

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.39"
        android:text="" />

    <Chronometer
        android:id="@+id/prayer_widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#F8F4EB"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:format="%s"
        android:visibility="gone" />

    <TextView
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="0.61"
        android:text="" />
  </LinearLayout>
</FrameLayout>
