<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/tahajjud_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/tahajjud_widget_bg"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="18dp"
  android:paddingTop="12dp"
  android:paddingEnd="18dp"
  android:paddingBottom="12dp">

  <TextView
    android:id="@+id/tahajjud_widget_eyebrow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:letterSpacing="0.16"
    android:maxLines="1"
    android:text="TAHAJJUD"
    android:textColor="#FFF4D995"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/tahajjud_widget_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:fontFamily="serif"
    android:maxLines="1"
    android:textColor="#FFFFFFFF"
    android:textSize="22sp" />

  <Chronometer
    android:id="@+id/tahajjud_widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:fontFamily="serif"
    android:textColor="#FFFFFFFF"
    android:textSize="28sp"
    android:visibility="gone" />

  <TextView
    android:id="@+id/tahajjud_widget_detail"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="2"
    android:textColor="#FFF2EEFA"
    android:textSize="13sp" />
</LinearLayout>
